# ─────────────────────────────────────────────
# Discord Bot Ayarları
# https://discord.com/developers/applications adresinden alınır
# ─────────────────────────────────────────────

# Bot token'ı (Bot > Token)
BOT_TOKEN=your_bot_token_here

# Uygulama Client ID (OAuth2 > Client ID)
CLIENT_ID=your_client_id_here

# Uygulama Client Secret (OAuth2 > Client Secret)
CLIENT_SECRET=your_client_secret_here

# ─────────────────────────────────────────────
# Veritabanı
# MongoDB Atlas: https://cloud.mongodb.com
# Ya da yerel: mongodb://localhost:27017/antiraid-bot
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/antiraid-bot

# ─────────────────────────────────────────────
# Dashboard Ayarları
# ─────────────────────────────────────────────

# Oturum şifrelemesi için rastgele uzun bir string
SESSION_SECRET=change_this_to_a_random_secret_string

# Dashboard portu
PORT=3000

# Discord OAuth2 callback URL
# Geliştirme: http://localhost:3000/auth/callback
# Production: https://yourdomain.com/auth/callback
CALLBACK_URL=http://localhost:3000/auth/callback
